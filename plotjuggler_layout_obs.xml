   </additional_sources>
  </snippet>
  <snippet name="ergodic_cost_ratio">
   <global>firstValue = 1
is_first = true</global>
   <function>-- on first invocation store initial v1
  if is_first then
    firstValue = value
    is_first = false
  end

  -- avoid division by zero
  if firstValue == 0 then
    return 0
  end

  return value / firstValue</function>
   <linked_source>/agent_1/data/ergodic_cost</linked_source>
  </snippet>
