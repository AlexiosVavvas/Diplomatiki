 <customMathEquations>
  <snippet name="energyratio">
   <global>firstValue = 1
is_first = true</global>
   <function>-- on first invocation store initial v1
  if is_first then
    firstValue = v2
    is_first = false
  end

  -- avoid division by zero
  if firstValue == 0 then
    return 0
  end

  return v2 / firstValue</function>
   <linked_source>/agent_1/aircraft_data/altitude</linked_source>
   <additional_sources>
    <v1>/agent_1/aircraft_data/airspeed</v1>
    <v2>energy</v2>
   </additional_sources>
  </snippet>
  <snippet name="energy">
   <global></global>
   <function>return value * value + v1</function>
   <linked_source>/agent_1/aircraft_data/airspeed</linked_source>
   <additional_sources>
