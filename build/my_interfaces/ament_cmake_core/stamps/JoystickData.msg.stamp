# Joystick control data
# All stick values normalized to -1.0 to 1.0 range
# Switch is binary 0 or 1

float64 throttle    # Throttle stick (channel 1)
float64 aileron     # Aileron stick (channel 3)
float64 elevator    # Elevator stick (channel 5)
float64 rudder      # Rudder stick (channel 7)
int32 switch_state  # Switch (channel 9) - binary 0/1
