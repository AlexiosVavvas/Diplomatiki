# AircraftData Message
# Complete flight state information for fixed-wing aircraft in NED frame

std_msgs/Header header           # Standard ROS header with timestamp and frame_id

# Position (NED frame, meters)
float64 north                    # Position north (m)
float64 east                     # Position east (m)
float64 down                     # Position down (m)
float64 altitude                 # Altitude above reference (m)

# Attitude (radians and degrees)
float64 roll                     # Roll angle (rad)
float64 pitch                    # Pitch angle (rad)
float64 yaw                      # Yaw angle (rad)
float64 roll_deg                 # Roll angle (deg)
float64 pitch_deg                # Pitch angle (deg)
float64 yaw_deg                  # Yaw angle (deg)

# Body frame velocities (m/s)
float64 u_forward                # Velocity along aircraft nose (m/s)
float64 v_sideways               # Velocity to the right (m/s)
float64 w_downward               # Velocity through aircraft belly (m/s)
float64 airspeed                 # Total airspeed (m/s)

# NED frame velocities (m/s)
float64 v_north                  # Velocity north (m/s)
float64 v_east                   # Velocity east (m/s)
float64 v_down                   # Velocity down (m/s)
float64 climb_rate               # Climb rate, positive up (m/s)
float64 ground_speed             # Horizontal ground speed (m/s)

# Angular rates (rad/s and deg/s)
float64 p_roll_rate              # Roll rate (rad/s)
float64 q_pitch_rate             # Pitch rate (rad/s)
float64 r_yaw_rate               # Yaw rate (rad/s)
float64 p_deg_s                  # Roll rate (deg/s)
float64 q_deg_s                  # Pitch rate (deg/s)
float64 r_deg_s                  # Yaw rate (deg/s)

# Aerodynamic angles
float64 alpha                    # Angle of attack (rad)
float64 beta                     # Sideslip angle (rad)
float64 alpha_deg                # Angle of attack (deg)
float64 beta_deg                 # Sideslip angle (deg)
