# AgentData Message
#This ROS message contains information about an agent's state and control data for ergodic control applications.

std_msgs/Header header           # Standard ROS header with timestamp and frame_id
float64 simulation_time

int8 num_of_states
int8 num_of_inputs
float64[] states
float64[] inputs
float64 ergodic_cost
bool active_cbf_flag

